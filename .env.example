# ==============================================================================
# Karta Navigation Platform — Phase 1 Environment Configuration
# Copy to .env before running docker compose: cp .env.example .env
# ==============================================================================

# PostgreSQL + PostGIS
POSTGRES_DB=karta
POSTGRES_USER=karta
POSTGRES_PASSWORD=karta_dev_change_me
POSTGRES_PORT=5432

# Redis Geo
REDIS_PORT=6379
REDIS_PASSWORD=

# Valhalla Routing Engine
VALHALLA_PORT=8002
VALHALLA_SERVER_THREADS=4
VALHALLA_BUILD_TRANSIT=True
VALHALLA_BUILD_ELEVATION=False

# PMTiles Vector Tile Server (go-pmtiles)
PMTILES_PORT=8081
PMTILES_PUBLIC_URL=http://localhost:8081

# Karta Core API (FastAPI)
KARTA_API_PORT=8000
KARTA_LOG_LEVEL=INFO
KARTA_ENV=development
KARTA_OFFLINE_PACKS_BASE_URL=http://localhost:8000/v1/regions/downloads

# Map & GTFS Pipeline Settings
OSM_SOURCE_URL=https://download.geofabrik.de/asia/malaysia-singapore-brunei-latest.osm.pbf
OSM_PBF_FILENAME=malaysia-singapore-brunei-latest.osm.pbf
PLANETILER_JAVA_XMX=4g

# Optional: Open Singapore GTFS bundle URL (Mobility Database / Community GTFS)
# Live LTA DataMall API integration is intentionally excluded in Phase 1.
SG_GTFS_STATIC_URL=https://github.com/thecrapone/singapore-gtfs-2026/releases/latest/download/gtfs.zip
