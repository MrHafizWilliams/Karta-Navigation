{
  "version": 8,
  "name": "Karta Dark 3D Automotive v1",
  "metadata": {
    "karta:schema": "openmaptiles",
    "karta:lighting_mode": "obsidianNight",
    "karta:palette": {
      "background_primary": "#0D0F12",
      "surface_card": "#181C22",
      "accent_primary": "#5B9A94",
      "text_primary": "#F4F6F8",
      "text_secondary": "#8E96A0"
    }
  },
  "light": {
    "anchor": "viewport",
    "color": "#E8F4F2",
    "intensity": 0.58,
    "position": [1.4, 215, 38]
  },
  "sources": {
    "karta_basemap": {
      "type": "vector",
      "url": "http://localhost:8081/my-sg-bn-full.json",
      "attribution": "OpenStreetMap contributors | Karta Navigation"
    }
  },
  "glyphs": "https://demotiles.maplibre.org/font/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#0D0F12"
      }
    },
    {
      "id": "landcover_highland",
      "type": "fill",
      "source": "karta_basemap",
      "source-layer": "landcover",
      "filter": ["in", "class", "wood", "rock", "grass", "wetland"],
      "paint": {
        "fill-color": [
          "match",
          ["get", "class"],
          "rock", "#1B2129",
          "wood", "#111E1B",
          "#101917"
        ],
        "fill-opacity": 0.78
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "karta_basemap",
      "source-layer": "park",
      "paint": {
        "fill-color": "#132622",
        "fill-opacity": 0.88
      }
    },
    {
      "id": "landuse_urban",
      "type": "fill",
      "source": "karta_basemap",
      "source-layer": "landuse",
      "filter": ["in", "class", "residential", "commercial", "industrial", "retail", "suburb"],
      "paint": {
        "fill-color": "#141921",
        "fill-opacity": 0.78
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "karta_basemap",
      "source-layer": "water",
      "paint": {
        "fill-color": "#070B12"
      }
    },
    {
      "id": "water_outline",
      "type": "line",
      "source": "karta_basemap",
      "source-layer": "water",
      "paint": {
        "line-color": "#152536",
        "line-width": 1.0
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "karta_basemap",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#0C1622",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.7, 15, 3.6]
      }
    },
    {
      "id": "aeroway_runway",
      "type": "line",
      "source": "karta_basemap",
      "source-layer": "aeroway",
      "filter": ["==", "class", "runway"],
      "paint": {
        "line-color": "#232A35",
        "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 10, 2, 16, 20]
      }
    },
    {
      "id": "roads_minor",
      "type": "line",
      "source": "karta_basemap",
      "source-layer": "transportation",
      "minzoom": 11,
      "filter": ["in", "class", "minor", "service", "track", "path", "street"],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#252E3B",
        "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 11, 0.7, 15, 3.8, 18, 10.5]
      }
    },
    {
      "id": "roads_secondary",
      "type": "line",
      "source": "karta_basemap",
      "source-layer": "transportation",
      "minzoom": 8,
      "filter": ["in", "class", "secondary", "tertiary"],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#324052",
        "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 8, 0.8, 14, 4.5, 17, 12.5]
      }
    },
    {
      "id": "roads_primary",
      "type": "line",
      "source": "karta_basemap",
      "source-layer": "transportation",
      "minzoom": 6,
      "filter": ["in", "class", "primary", "trunk"],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#42556B",
        "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 6, 1.0, 14, 6.0, 17, 15.0]
      }
    },
    {
      "id": "roads_motorway_casing",
      "type": "line",
      "source": "karta_basemap",
      "source-layer": "transportation",
      "filter": ["==", "class", "motorway"],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#090B0E",
        "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 5, 2.4, 12, 6.6, 17, 18.0]
      }
    },
    {
      "id": "roads_motorway",
      "type": "line",
      "source": "karta_basemap",
      "source-layer": "transportation",
      "filter": ["==", "class", "motorway"],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#5B9A94",
        "line-opacity": 0.86,
        "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 5, 1.2, 12, 4.2, 17, 14.0]
      }
    },
    {
      "id": "buildings_footprint",
      "type": "fill",
      "source": "karta_basemap",
      "source-layer": "building",
      "minzoom": 12.0,
      "paint": {
        "fill-color": "#1A2029",
        "fill-outline-color": "#2B3544",
        "fill-opacity": 0.88
      }
    },
    {
      "id": "buildings_3d",
      "type": "fill-extrusion",
      "source": "karta_basemap",
      "source-layer": "building",
      "minzoom": 13.0,
      "filter": ["!=", ["get", "hide_3d"], true],
      "paint": {
        "fill-extrusion-color": [
          "interpolate",
          ["linear"],
          ["coalesce", ["get", "render_height"], ["get", "height"], 16],
          0, "#1D242E",
          35, "#263240",
          90, "#314552",
          180, "#41686B",
          320, "#5B9A94",
          450, "#78C2BA"
        ],
        "fill-extrusion-height": [
          "interpolate",
          ["linear"],
          ["zoom"],
          13.0, 0,
          13.8, ["coalesce", ["get", "render_height"], ["get", "height"], 16]
        ],
        "fill-extrusion-base": [
          "interpolate",
          ["linear"],
          ["zoom"],
          13.0, 0,
          13.8, ["coalesce", ["get", "render_min_height"], ["get", "min_height"], 0]
        ],
        "fill-extrusion-opacity": 0.94,
        "fill-extrusion-vertical-gradient": true
      }
    },
    {
      "id": "boundaries_state",
      "type": "line",
      "source": "karta_basemap",
      "source-layer": "boundary",
      "minzoom": 5,
      "filter": ["all", ["==", "admin_level", 4], ["!=", "maritime", 1]],
      "paint": {
        "line-color": "#3E4754",
        "line-dasharray": [3, 3],
        "line-width": 1.0
      }
    },
    {
      "id": "boundaries_country",
      "type": "line",
      "source": "karta_basemap",
      "source-layer": "boundary",
      "filter": ["all", ["==", "admin_level", 2], ["!=", "maritime", 1]],
      "paint": {
        "line-color": "#8E96A0",
        "line-dasharray": [4, 2],
        "line-width": 1.5
      }
    },
    {
      "id": "mountain_peaks_label",
      "type": "symbol",
      "source": "karta_basemap",
      "source-layer": "mountain_peak",
      "minzoom": 9,
      "layout": {
        "text-field": [
          "case",
          ["has", "ele"],
          ["concat", "▲ ", ["coalesce", ["get", "name:en"], ["get", "name"]], "\n", ["to-string", ["get", "ele"]], "m"],
          ["concat", "▲ ", ["coalesce", ["get", "name:en"], ["get", "name"]]]
        ],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 9, 9.5, 13, 11.5],
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#72B8B1",
        "text-halo-color": "#0D0F12",
        "text-halo-width": 1.6
      }
    },
    {
      "id": "water_name",
      "type": "symbol",
      "source": "karta_basemap",
      "source-layer": "water_name",
      "minzoom": 7,
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 7, 10.5, 14, 13.5]
      },
      "paint": {
        "text-color": "#5E8CA3",
        "text-halo-color": "#070B12",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "building_housenumber",
      "type": "symbol",
      "source": "karta_basemap",
      "source-layer": "housenumber",
      "minzoom": 16.0,
      "layout": {
        "text-field": ["get", "housenumber"],
        "text-font": ["Noto Sans Regular"],
        "text-size": 10.0
      },
      "paint": {
        "text-color": "#7D8794",
        "text-halo-color": "#0D0F12",
        "text-halo-width": 1.3
      }
    },
    {
      "id": "roads_label_minor",
      "type": "symbol",
      "source": "karta_basemap",
      "source-layer": "transportation_name",
      "minzoom": 12.2,
      "filter": ["in", "class", "minor", "service", "track", "path", "street", "tertiary"],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"], ["get", "ref"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 12.2, 10.0, 16, 12.2]
      },
      "paint": {
        "text-color": "#8E96A0",
        "text-halo-color": "#0D0F12",
        "text-halo-width": 1.5,
        "text-opacity": 0.94,
        "text-opacity-transition": { "duration": 380 }
      }
    },
    {
      "id": "roads_label_major",
      "type": "symbol",
      "source": "karta_basemap",
      "source-layer": "transportation_name",
      "minzoom": 9,
      "filter": ["in", "class", "motorway", "trunk", "primary", "secondary"],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"], ["get", "ref"]],
        "text-font": ["Open Sans Semibold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 9, 10.5, 16, 13.5]
      },
      "paint": {
        "text-color": "#DCE4EC",
        "text-halo-color": "#0D0F12",
        "text-halo-width": 1.8
      }
    },
    {
      "id": "roads_shield_number",
      "type": "symbol",
      "source": "karta_basemap",
      "source-layer": "transportation_name",
      "minzoom": 7,
      "filter": ["has", "ref"],
      "layout": {
        "symbol-placement": "line",
        "symbol-spacing": 280,
        "text-field": ["get", "ref"],
        "text-font": ["Open Sans Semibold"],
        "text-size": 10.5,
        "text-rotation-alignment": "viewport",
        "text-pitch-alignment": "viewport"
      },
      "paint": {
        "text-color": "#F4F6F8",
        "text-halo-color": "#006B44",
        "text-halo-width": 2.2
      }
    },
    {
      "id": "poi_landmarks",
      "type": "symbol",
      "source": "karta_basemap",
      "source-layer": "poi",
      "minzoom": 12.2,
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-font": ["Open Sans Semibold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 12.2, 10.0, 16, 12.0],
        "text-max-width": 9
      },
      "paint": {
        "text-color": "#DCE4EC",
        "text-halo-color": "#0D0F12",
        "text-halo-width": 1.8
      }
    },
    {
      "id": "place_suburb_neighbourhood",
      "type": "symbol",
      "source": "karta_basemap",
      "source-layer": "place",
      "minzoom": 10.5,
      "filter": ["in", "class", "suburb", "neighbourhood", "quarter", "village", "hamlet", "locality", "isolated_dwelling"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 10.5, 10.5, 15, 13.0],
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#A4B0BD",
        "text-halo-color": "#0D0F12",
        "text-halo-width": 1.9
      }
    },
    {
      "id": "places_label",
      "type": "symbol",
      "source": "karta_basemap",
      "source-layer": "place",
      "filter": ["in", "class", "country", "state", "city", "town", "suburb"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-font": ["Open Sans Semibold"],
        "text-size": [
          "match",
          ["get", "class"],
          "country", 15,
          "city", 14,
          "town", 12.5,
          11
        ],
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#F4F6F8",
        "text-halo-color": "#0D0F12",
        "text-halo-width": 1.7
      }
    }
  ]
}
