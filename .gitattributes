# Ensure Unix LF line endings for Docker containers and Linux scripts
*.sh text eol=lf
*.lua text eol=lf
*.sql text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.geojson text eol=lf
*.csv text eol=lf
Dockerfile text eol=lf
Makefile text eol=lf
*.ps1 text eol=crlf
